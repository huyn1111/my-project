{
  "autoUpdatesChannel": "latest",
  "model": "claude-sonnet-4-6",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{
          "type": "command",
          "command": "[ \"$(git branch --show-current)\" != \"main\" ] || { echo '{\"block\":true,\"message\":\"main 브랜치 수정 금지\"}' >&2; exit 2; }",
          "timeout": 5
        }]
      },
      {
        "matcher": "Bash",
        "hooks": [{
          "type": "command",
          "command": "bash \"$HOME/.claude/hooks/swift-commit-guard.sh\"",
          "timeout": 15
        }]
      }
    ]
  }
}
